#!/bin/sh
# Block a commit that would add personal details to this repo. See scripts/pii_guard.py.
#
# Tracked in the repo rather than installed into .git/hooks, so it travels with a clone
# instead of living only on one machine. Activate it once with:
#
#     git config core.hooksPath .githooks
#
# (bootstrap.py does this for you.)

# The console UI ships prebuilt in web/frontend/dist/. A commit that changes its sources
# without the rebuilt dist/ would give users a UI that does not match the code.
staged=$(git diff --cached --name-only)
if echo "$staged" | grep -q '^web/frontend/src/' && ! echo "$staged" | grep -q '^web/frontend/dist/'; then
    echo "[dist-check] web/frontend/src changed but web/frontend/dist did not. Rebuild it:" >&2
    echo "    (cd web/frontend && npm run build) && git add -A web/frontend/dist" >&2
    exit 1
fi

if command -v python >/dev/null 2>&1; then
    PY=python
elif command -v python3 >/dev/null 2>&1; then
    PY=python3
elif command -v py >/dev/null 2>&1; then
    PY=py
else
    # Warn loudly but let the commit through. A hook that hard-fails on an environment
    # quirk gets switched off entirely, and a switched-off hook protects nothing.
    echo "[pii-guard] no python on PATH, skipping the personal-details check." >&2
    exit 0
fi

exec "$PY" scripts/pii_guard.py --staged
